# Use mock mode to develop without a Home Lab server.
HOMELAB_PROVIDER=mock

# Future Linux agent endpoint. Leave blank while working with mocks.
HOMELAB_AGENT_URL=

# Optional shared token for the future Linux agent. Never commit real values.
HOMELAB_AGENT_TOKEN=

# Request timeout in milliseconds (default: 5000).
HOMELAB_AGENT_TIMEOUT_MS=5000
